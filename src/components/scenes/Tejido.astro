---
import { Image } from 'astro:assets';
import rope from '../../assets/photos/rope-memory.jpg';
import agc from '../../assets/photos/agc-sealed.jpg';
import { getLang, translator } from '../../i18n';

const lang = getLang(Astro);
const t = translator(lang);

// The program lived in six core rope memory modules that plugged into the computer
const SLOT = 84;
const TRAY_X = 18;
const modules = Array.from({ length: 6 }, (_, i) => TRAY_X + i * SLOT + 8);

// 1202 (octal) in binary: a wire that passes through (1) or around (0) each core
const bits = '001010000010'.split('').map(Number);
const X0 = 70;
const STEP = 88;
const CY = 120;
const LOW = 196;
const RX = 11;
const RY = 36;

const cores = bits.map((bit, i) => ({ bit, x: X0 + i * STEP, c: (i + 0.5) / bits.length }));
const ys = bits.map((bit) => (bit ? CY : LOW));
const endX = X0 + (bits.length - 1) * STEP + 70;

let wire = `M 0 ${ys[0]} L ${X0 - 50} ${ys[0]}`;
cores.forEach(({ x }, i) => {
	const prevX = i === 0 ? X0 - 50 : cores[i - 1].x + 24;
	const prevY = i === 0 ? ys[0] : ys[i - 1];
	wire += ` C ${prevX + 22} ${prevY} ${x - 46} ${ys[i]} ${x - 24} ${ys[i]} L ${x + 24} ${ys[i]}`;
});
wire += ` L ${endX} ${ys[ys.length - 1]}`;

// Each core is a ring seen edge-on: the left half sits behind the wire and the right half in front
const arc = (x: number, back: boolean) =>
	back
		? `M ${x} ${CY - RY} A ${RX} ${RY} 0 0 0 ${x} ${CY + RY}`
		: `M ${x} ${CY - RY} A ${RX} ${RY} 0 0 1 ${x} ${CY + RY}`;
---

<section class="scene tejido" data-scene="tejido" data-theme="copper" data-year="1969" style="--len: 520">
	<div class="stage">
		<div class="layer agc" style="--b: 0.22">
			<svg
				viewBox={`0 60 ${6 * SLOT + 2 * TRAY_X} 340`}
				role="img"
				aria-label={t({
					es: 'Seis módulos de memoria de cuerda encajan, uno tras otro, en el ordenador del Apollo. Entre todos guardan el programa entero.',
					en: 'Six core rope memory modules slot, one by one, into the Apollo computer. Together they hold the entire program.',
				})}
			>
				<defs>
					<pattern id="tejido-cores" width="10" height="9" patternUnits="userSpaceOnUse">
						<circle cx="2.5" cy="2.25" r="2.1" />
						<circle cx="7.5" cy="6.75" r="2.1" />
					</pattern>
					<pattern id="tejido-pins" width="7" height="4" patternUnits="userSpaceOnUse">
						<rect y="1.3" width="7" height="1.4" />
					</pattern>
				</defs>

				<rect class="tray-back" x={TRAY_X - 10} y="96" width={6 * SLOT + 20} height="282" rx="4" />
				{modules.slice(1).map((x) => <line class="rail" x1={x - 8} y1="104" x2={x - 8} y2="352" />)}
				<g class="modules">
					{
						modules.map((x, i) => (
							<g class="module" style={`--i:${i}`}>
								<rect class="case" x={x} y="112" width="68" height="250" rx="3" />
								<rect class="pins" x={x + 4} y="122" width="7" height="230" />
								<rect class="pins" x={x + 57} y="122" width="7" height="230" />
								<rect class="cores" x={x + 14} y="124" width="40" height="226" />
							</g>
						))
					}
				</g>
				<rect class="tray-front" x={TRAY_X - 14} y="352" width={6 * SLOT + 28} height="40" rx="3" />
			</svg>
			<p class="agc-caption mono" aria-hidden="true">
				{t({ es: '6 módulos × 6.144 palabras ≈ 72 KB', en: '6 modules × 6,144 words ≈ 72 KB' })}
			</p>
		</div>

		<div class="layer photo" style="--a: 0.62; --b: 0.8">
			<Image
				src={rope}
				alt={t({
					es: 'Un módulo de memoria de cuerda del ordenador del Apollo: cientos de núcleos de ferrita atravesados por hilos de cobre',
					en: 'A core rope memory module from the Apollo computer: hundreds of ferrite cores threaded with copper wire',
				})}
				widths={[664]}
			/>
		</div>

		<div class="layer photo sealed" style="--a: 0.8">
			<Image
				src={agc}
				alt={t({
					es: 'El ordenador de guiado del Apollo, una caja metálica cerrada, junto a su teclado DSKY',
					en: 'The Apollo Guidance Computer, a closed metal case, next to its DSKY keyboard',
				})}
				widths={[760, 1520]}
				sizes="(min-width: 760px) 760px, 100vw"
			/>
		</div>

		<svg class="rope layer" style="--a: 0.24; --b: 0.62" viewBox={`0 0 ${endX} 270`} aria-hidden="true">
			{cores.map(({ x }) => <path class="core" d={arc(x, true)} />)}
			<path class="wire" d={wire} pathLength="1" />
			{cores.map(({ x }) => <path class="core front" d={arc(x, false)} />)}
			{
				cores.map(({ x, bit, c }) => (
					<text class="bit" x={x} y="262" style={`--c:${c.toFixed(3)}`}>
						{bit}
					</text>
				))
			}
		</svg>

		<div class="text stack">
			<p class="beat" data-beat="0 0.14">{t({ es: 'El software no se instalaba.', en: 'Software wasn’t installed.' })}</p>
			<p class="beat big" data-beat="0.14 0.26">{t({ es: 'Se tejía.', en: 'It was woven.' })}</p>
			<p class="beat" data-beat="0.26 0.5">
				{
					t({
						es: 'Un hilo que atraviesa un núcleo es un 1. Uno que lo esquiva, un 0.',
						en: 'A wire through a core is a 1. A wire around it, a 0.',
					})
				}
			</p>
			<p class="beat" data-beat="0.5 0.62">
				{
					lang === 'es' ? (
						<>Este hilo escribe <span class="mono">1202</span>, el número de la alarma, en binario.</>
					) : (
						<>This wire spells <span class="mono">1202</span>, the alarm code, in binary.</>
					)
				}
			</p>
			<p class="beat" data-beat="0.62 0.8">
				{
					t({
						es: 'Lo tejían a mano, sobre todo mujeres, en una fábrica de Raytheon.',
						en: 'It was woven by hand, mostly by women, at a Raytheon factory.',
					})
				}
			</p>
			<p class="beat" data-beat="0.8">
				{
					t({
						es: 'Una vez tejido, no se podía cambiar. Tenía que estar bien a la primera.',
						en: 'Once woven, it couldn’t be changed. It had to be right the first time.',
					})
				}
			</p>
		</div>
	</div>
</section>

<style>
	.agc {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		padding: 12vh var(--gutter) 0;
	}

	.agc svg {
		--g: clamp(0, calc((var(--p, 1) - 0.15) / 0.05), 1);
		width: min(100%, 680px);
		height: auto;
		max-height: 44vh;
	}

	.tray-back {
		fill: rgb(0 0 0 / 0.22);
		stroke: #7a7067;
		stroke-width: 1.5;
	}

	.rail {
		stroke: #5e4a3d;
		stroke-dasharray: 3 5;
	}

	.tray-front {
		fill: #2f1a0f;
		stroke: #8a8178;
		stroke-width: 1.5;
	}

	/* Each module slides down into its slot, one after another */
	.module {
		--k: clamp(0, calc((var(--p, 1) - 0.01 - var(--i) * 0.017) / 0.035), 1);
		--e: calc(var(--k) * var(--k) * (3 - 2 * var(--k)));
		opacity: var(--k);
		transform: translateY(calc((var(--e) - 1) * 130px));
	}

	.case {
		fill: #170a04;
		stroke: #6f675f;
		stroke-width: 1.5;
	}

	.pins {
		fill: url(#tejido-pins);
	}

	#tejido-pins rect {
		fill: #9c938a;
	}

	.cores {
		fill: url(#tejido-cores);
	}

	/* “It was woven”: the copper inside lights up */
	#tejido-cores circle {
		fill: none;
		stroke: var(--hilo);
		stroke-width: 1.4;
		opacity: calc(0.4 + 0.6 * var(--g));
	}

	.modules {
		filter: drop-shadow(0 0 calc(var(--g) * 10px) rgb(217 138 78 / calc(var(--g) * 0.5)));
	}

	.agc-caption {
		color: var(--fg-dim);
		text-align: center;
		opacity: clamp(0, calc((var(--p, 1) - 0.12) / 0.02), 1);
	}

	.photo {
		display: grid;
		place-items: center;
		padding: 10vh var(--gutter) 34vh;
	}

	.photo img {
		width: min(100%, 760px);
		height: auto;
		filter: sepia(0.25) saturate(1.1);
		box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
	}

	/* The blue studio background, shifted to the scene's copper tone */
	.sealed img {
		filter: sepia(0.6) saturate(0.85);
	}

	.rope {
		--w: clamp(0, calc((var(--p, 1) - 0.27) / 0.2), 1);
		inset: 14vh var(--gutter) auto;
		width: calc(100% - 2 * var(--gutter));
		height: auto;
		max-height: 46vh;
	}

	.core {
		fill: none;
		stroke: #5b544d;
		stroke-width: 11;
	}

	.core.front {
		stroke: #6f675f;
	}

	.wire {
		fill: none;
		stroke: var(--hilo);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: calc(1 - var(--w));
		filter: drop-shadow(0 0 6px rgb(217 138 78 / 0.5));
	}

	.bit {
		font-family: var(--font-mono);
		font-size: 22px;
		text-anchor: middle;
		fill: var(--fg);
		opacity: clamp(0, calc((var(--w) - var(--c)) * 20), 1);
	}

	.text {
		position: absolute;
		left: var(--gutter);
		right: var(--gutter);
		bottom: clamp(3.5rem, 12vh, 8rem);
		align-items: end;
	}

	.text p {
		max-width: 24ch;
		font-size: var(--t-lead);
		line-height: 1.12;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	.text .big {
		font-size: var(--t-giant);
		font-weight: 300;
		font-style: italic;
		line-height: 0.95;
	}

	.text .mono {
		font-size: 0.8em;
		color: var(--hilo);
	}

	@media (max-width: 760px) {
		.text p:not(.big) {
			font-size: 1.35rem;
		}

		.rope {
			inset: 18vh 0 auto;
			width: 100%;
		}

		.agc {
			padding-top: 16vh;
		}
	}

	html:not(.js) .text,
	html:not(.js) .layer {
		position: relative;
		inset: auto;
	}
</style>
