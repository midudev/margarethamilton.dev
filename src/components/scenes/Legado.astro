---
import { Image } from 'astro:assets';
import avatar1969 from '../../assets/photos/margaret-1969-avatar.jpg';
import avatar1989 from '../../assets/photos/margaret-1989-avatar.jpg';
import banner from '../../assets/photos/earth-over-moon.jpg';
import medal from '../../assets/photos/medal-of-freedom-2016.jpg';
import { getLang, translator } from '../../i18n';

/**
 * Her career after Apollo, as a LinkedIn profile that updates as you scroll:
 * new positions, a new photo, endorsed skills and awards. LinkedIn wasn't founded until
 * 2003, so this is the profile she would have had.
 */
const t = translator(getLang(Astro));

// Scene moments (progress from 0 to 1)
const HOS = 0.1;
const HTI = 0.24;
const AVATAR = 0.31;
const SKILLS = 0.4;
const NASA = 0.54;
const MEDAL = 0.68;
const PHOTO = 0.76;
const QUOTE = 0.86;

/** data-beat value: “from” or “from to” */
const b = (...at: number[]) => at.map((n) => +n.toFixed(3)).join(' ');

const headlines = [
	{ beat: b(0, HOS), text: t({ es: 'Directora de Ingeniería de Software en el MIT · Apollo', en: 'Director of Software Engineering at MIT · Apollo' }) },
	{ beat: b(HOS, HTI), text: t({ es: 'Cofundadora y CEO en Higher Order Software', en: 'Co-founder & CEO at Higher Order Software' }) },
	{
		beat: b(HTI),
		text: t({
			es: 'Fundadora y CEO en Hamilton Technologies · Creadora del Universal Systems Language',
			en: 'Founder & CEO at Hamilton Technologies · Creator of the Universal Systems Language',
		}),
	},
];

const MIT = { text: 'MIT', bg: '#a31f34' };

const experience = [
	{
		at: HTI,
		logo: { text: 'HTI', bg: '#1d4f91' },
		title: t({ es: 'Fundadora y CEO', en: 'Founder & CEO' }),
		org: 'Hamilton Technologies, Inc.',
		dates: [{ text: t({ es: 'mar. 1986 – actualidad', en: 'Mar 1986 – Present' }) }],
		place: 'Cambridge, Massachusetts',
		text: t({
			es: 'Creé el Universal Systems Language y la suite 001: prevenir los errores antes de que existan.',
			en: 'I created the Universal Systems Language and the 001 Tool Suite: preventing errors before they exist.',
		}),
	},
	{
		at: HOS,
		logo: { text: 'HOS', bg: '#3b3f46' },
		title: t({ es: 'Cofundadora y CEO', en: 'Co-founder & CEO' }),
		org: 'Higher Order Software',
		dates: [
			{ beat: b(0, HTI), text: t({ es: '1976 – actualidad', en: '1976 – Present' }) },
			{ beat: b(HTI), text: '1976 – 1984' },
		],
		place: 'Cambridge, Massachusetts',
		text: t({
			es: 'Con Saydean Zeldin, para llevar a otros proyectos lo que aprendimos en el Apollo: prevenir errores y tolerar fallos.',
			en: 'With Saydean Zeldin, to take what Apollo taught us to other projects: preventing errors and tolerating faults.',
		}),
	},
	{
		logo: MIT,
		title: t({ es: 'Directora de la División de Ingeniería de Software', en: 'Director, Software Engineering Division' }),
		org: 'MIT Instrumentation Laboratory',
		dates: [
			{ beat: b(0, HOS), text: t({ es: '1965 – actualidad', en: '1965 – Present' }) },
			{ beat: b(HOS), text: '1965 – 1976' },
		],
		place: 'Cambridge, Massachusetts',
		text: t({
			es: 'Software de vuelo del Apollo y del Skylab, con un equipo de más de 400 personas. Llevamos a la humanidad a la Luna.',
			en: 'Flight software for Apollo and Skylab, with a team of over 400 people. We took humanity to the Moon.',
		}),
	},
	{
		logo: { text: 'LL', bg: '#28466e' },
		title: t({ es: 'Programadora · Proyecto SAGE', en: 'Programmer · SAGE project' }),
		org: 'MIT Lincoln Laboratory',
		dates: [{ text: '1961 – 1963' }],
		place: 'Lexington, Massachusetts',
		text: t({
			es: 'Me dieron el programa que nadie conseguía hacer funcionar, con los comentarios en griego y latín. Funcionó.',
			en: 'They gave me the program nobody could get working, commented in Greek and Latin. It worked.',
		}),
	},
	{
		logo: MIT,
		title: t({ es: 'Programadora', en: 'Programmer' }),
		org: t({ es: 'MIT · Departamento de Meteorología', en: 'MIT · Department of Meteorology' }),
		dates: [{ text: '1959 – 1961' }],
		place: 'Cambridge, Massachusetts',
		text: t({
			es: 'Software de predicción del tiempo para Edward Lorenz. Sí, el del efecto mariposa.',
			en: 'Weather prediction software for Edward Lorenz. Yes, the butterfly effect one.',
		}),
	},
	{
		title: t({ es: 'Profesora de Matemáticas y Francés', en: 'Math and French teacher' }),
		org: t({ es: 'Instituto público', en: 'Public high school' }),
		dates: [{ text: '1958' }],
		place: 'Boston, Indiana',
		text: t({ es: 'Boston, Indiana. El otro Boston llegaría después.', en: 'Boston, Indiana. The other Boston came later.' }),
	},
];

const skills = [
	{
		name: t({ es: 'Ingeniería de software', en: 'Software engineering' }),
		note: t({ es: 'Le puso nombre ella', en: 'She coined the term' }),
	},
	{
		name: t({ es: 'Programación defensiva', en: 'Defensive programming' }),
		faces: ['LH', 'JL'],
		note: t({
			es: 'Lauren Hamilton y Jim Lovell han validado esta aptitud',
			en: 'Endorsed by Lauren Hamilton and Jim Lovell',
		}),
	},
	{
		name: t({ es: 'Gestión de prioridades en tiempo real', en: 'Real-time priority scheduling' }),
		faces: ['NA', 'BA'],
		note: t({
			es: 'Neil Armstrong y Buzz Aldrin han validado esta aptitud, a 10 km de la Luna',
			en: 'Endorsed by Neil Armstrong and Buzz Aldrin, 33,500 feet above the Moon',
		}),
	},
];

const awards = [
	{
		at: MEDAL,
		title: t({ es: 'Medalla Presidencial de la Libertad', en: 'Presidential Medal of Freedom' }),
		issuer: t({ es: 'Otorgado por el presidente Barack Obama · nov. 2016', en: 'Issued by President Barack Obama · Nov 2016' }),
		text: t({ es: 'La mayor distinción civil de Estados Unidos.', en: 'The highest civilian honor in the United States.' }),
	},
	{
		at: NASA,
		title: 'NASA Exceptional Space Act Award',
		issuer: t({ es: 'Otorgado por la NASA · 2003', en: 'Issued by NASA · 2003' }),
		text: t({
			es: '37.200 dólares, el premio más alto que la NASA había dado nunca a una persona.',
			en: '$37,200, the largest award NASA had ever given to an individual.',
		}),
	},
	{
		at: HTI,
		title: 'Augusta Ada Lovelace Award',
		issuer: t({
			es: 'Otorgado por la Association for Women in Computing · 1986',
			en: 'Issued by the Association for Women in Computing · 1986',
		}),
		text: t({ es: 'Lleva el nombre de la primera programadora de la historia.', en: 'Named after the first programmer in history.' }),
	},
];

const languages = [
	{ name: t({ es: 'Inglés', en: 'English' }), level: t({ es: 'Competencia bilingüe o nativa', en: 'Native or bilingual proficiency' }) },
	{ name: t({ es: 'Francés', en: 'French' }), level: t({ es: 'Competencia profesional completa', en: 'Full professional proficiency' }) },
	{ name: t({ es: 'Ensamblador del AGC', en: 'AGC assembly' }), level: t({ es: 'Competencia bilingüe o nativa', en: 'Native or bilingual proficiency' }) },
];

// Notifications she receives; each one adds one to the bell
const toasts = [
	{
		from: HOS + 0.01,
		to: HTI - 0.02,
		icon: 'jobs',
		title: t({ es: '¡Enhorabuena por tu nuevo puesto!', en: 'Congrats on your new role!' }),
		text: t({ es: 'Cofundadora y CEO en Higher Order Software', en: 'Co-founder & CEO at Higher Order Software' }),
	},
	{
		from: HTI + 0.01,
		to: AVATAR - 0.01,
		icon: 'jobs',
		title: t({ es: '¡Enhorabuena por tu nuevo puesto!', en: 'Congrats on your new role!' }),
		text: t({ es: 'Fundadora y CEO en Hamilton Technologies', en: 'Founder & CEO at Hamilton Technologies' }),
	},
	{
		from: AVATAR,
		to: SKILLS - 0.02,
		icon: 'camera',
		title: t({ es: 'Has actualizado tu foto de perfil', en: 'You updated your profile photo' }),
		text: t({ es: 'La anterior era de 1969', en: 'The last one was from 1969' }),
	},
	{
		from: NASA + 0.04,
		to: MEDAL - 0.01,
		icon: 'in',
		title: t({ es: 'Acaba de nacer LinkedIn', en: 'LinkedIn has just launched' }),
		text: t({ es: 'Mayo de 2003. Este perfil llevaba 27 años esperando.', en: 'May 2003. This profile had been waiting 27 years.' }),
	},
	{
		from: MEDAL + 0.01,
		to: PHOTO,
		icon: 'eye',
		title: t({ es: 'Barack Obama ha visto tu perfil', en: 'Barack Obama viewed your profile' }),
		text: t({ es: 'Presidente de los Estados Unidos', en: 'President of the United States' }),
	},
];
const badges = toasts.map((toast, i) => b(toast.from, toasts[i + 1]?.from ?? 1.01));

const icons: Record<string, string> = {
	search: '<circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2"/>',
	home: '<path d="M3 11 12 3.5l9 7.5v10h-6.5v-6h-5v6H3z"/>',
	network: '<circle cx="9" cy="7.5" r="3.5"/><path d="M2 20c0-3.9 3.1-7 7-7s7 3.1 7 7z"/><circle cx="17.5" cy="8.5" r="2.5"/><path d="M16.5 12.6A5.5 5.5 0 0 1 22.5 18H18a8.6 8.6 0 0 0-1.5-5.4z"/>',
	jobs: '<path fill-rule="evenodd" d="M9 3.5h6A1.5 1.5 0 0 1 16.5 5v1.5H20A1.5 1.5 0 0 1 21.5 8v11a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 19V8A1.5 1.5 0 0 1 4 6.5h3.5V5A1.5 1.5 0 0 1 9 3.5zm.5 3h5V5.5h-5z"/>',
	bell: '<path d="M12 2.5a6.5 6.5 0 0 0-6.5 6.5v4.2L3.5 16.5v1h17v-1l-2-3.3V9A6.5 6.5 0 0 0 12 2.5zM9.5 19a2.5 2.5 0 0 0 5 0z"/>',
	camera: '<path fill-rule="evenodd" d="M8.5 4h7l1.5 2.5h3A1.5 1.5 0 0 1 21.5 8v10.5A1.5 1.5 0 0 1 20 20H4a1.5 1.5 0 0 1-1.5-1.5V8A1.5 1.5 0 0 1 4 6.5h3zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>',
	eye: '<path fill-rule="evenodd" d="M12 5c6.5 0 10 7 10 7s-3.5 7-10 7S2 12 2 12s3.5-7 10-7zm0 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/><circle cx="12" cy="12" r="2"/>',
	building: '<path d="M5 21V4.5L13 3v18zm9.5 0V9H19v12zM7.5 7v2h2V7zm0 4v2h2v-2zm0 4v2h2v-2z" fill-rule="evenodd"/>',
	award: '<circle cx="12" cy="9" r="6"/><path d="m8 14-2 8 6-3 6 3-2-8a7.5 7.5 0 0 1-8 0z"/>',
};
---

<section class="scene legado" data-scene="legado" data-theme="wall" data-year="1976" style="--len: 900">
	<div class="stage">
		<div class="layer profile-layer" style={`--b: ${PHOTO + 0.03}`}>
			<div class="slot">
				<div class="window">
					<div class="bar" aria-hidden="true">
						<i></i><i></i><i></i>
						<span class="url">linkedin.com/in/margarethamilton</span>
					</div>

					<div class="nav" aria-hidden="true">
						<span class="in">in</span>
						<span class="search"><svg viewBox="0 0 24 24" set:html={icons.search} />{t({ es: 'Buscar', en: 'Search' })}</span>
						<span class="nav-items">
							<span><svg viewBox="0 0 24 24" set:html={icons.home} /><small>{t({ es: 'Inicio', en: 'Home' })}</small></span>
							<span><svg viewBox="0 0 24 24" set:html={icons.network} /><small>{t({ es: 'Mi red', en: 'My Network' })}</small></span>
							<span><svg viewBox="0 0 24 24" set:html={icons.jobs} /><small>{t({ es: 'Empleos', en: 'Jobs' })}</small></span>
							<span>
								<svg viewBox="0 0 24 24" set:html={icons.bell} />
								<small>{t({ es: 'Notificaciones', en: 'Notifications' })}</small>
								<span class="badge">{badges.map((beat, i) => <span data-beat={beat}>{i + 1}</span>)}</span>
							</span>
						</span>
					</div>

					<div class="viewport" data-viewport>
						<article
							class="page"
							data-page
							aria-label={t({ es: 'El perfil de LinkedIn que habría tenido Margaret Hamilton', en: 'The LinkedIn profile Margaret Hamilton would have had' })}
						>
							<section class="card top" data-beat="0" data-pan="start">
								<div class="banner">
									<Image src={banner} alt="" widths={[640, 1280]} sizes="(max-width: 760px) 92vw, 52rem" />
								</div>
								<div class="avatar" data-beat={b(AVATAR)} data-pan="start">
									<Image src={avatar1969} alt={t({ es: 'Margaret Hamilton en 1969', en: 'Margaret Hamilton in 1969' })} widths={[160, 320]} sizes="140px" />
									<Image
										src={avatar1989}
										alt={t({ es: 'Margaret Hamilton en 1989', en: 'Margaret Hamilton in 1989' })}
										widths={[160, 320]}
										sizes="140px"
										data-beat={b(AVATAR)}
									/>
								</div>
								<div class="intro">
									<h3 class="name">Margaret Hamilton <small>{t({ es: 'Ella', en: 'She/Her' })}</small></h3>
									<p class="swap headline">{headlines.map(({ beat, text }) => <span data-beat={beat}>{text}</span>)}</p>
									<p class="dim">
										{t({ es: 'Cambridge, Massachusetts, Estados Unidos', en: 'Cambridge, Massachusetts, United States' })} ·{' '}
										<span class="link">{t({ es: 'Información de contacto', en: 'Contact info' })}</span>
									</p>
									<p class="link">{t({ es: 'Más de 500 contactos', en: '500+ connections' })}</p>
									<p class="actions" aria-hidden="true">
										<span class="primary">{t({ es: 'Abierta a', en: 'Open to' })}</span>
										<span>{t({ es: 'Añadir sección', en: 'Add section' })}</span>
										<span>{t({ es: 'Más', en: 'More' })}</span>
									</p>
								</div>
							</section>

							<section class="card">
								<h4>{t({ es: 'Experiencia', en: 'Experience' })}</h4>
								<ul class="list">
									{
										experience.map((job) => (
											<li class="entry" data-beat={job.at && b(job.at)} data-pan={job.at && 'end'}>
												<div class="clip">
													<div class="row">
														{job.logo ? (
															<span class="logo" style={`--bg:${job.logo.bg}`} aria-hidden="true">
																{job.logo.text}
															</span>
														) : (
															<span class="logo blank" aria-hidden="true">
																<svg viewBox="0 0 24 24" set:html={icons.building} />
															</span>
														)}
														<div>
															<p class="title">{job.title}</p>
															<p>{job.org}</p>
															<p class="dim">
																{job.dates.length > 1 ? (
																	<span class="swap">
																		{job.dates.map(({ beat, text }) => (
																			<span data-beat={beat}>{text}</span>
																		))}
																	</span>
																) : (
																	job.dates[0].text
																)}
															</p>
															<p class="dim">{job.place}</p>
															<p class="desc">{job.text}</p>
														</div>
													</div>
												</div>
											</li>
										))
									}
								</ul>
							</section>

							<section class="card">
								<h4>{t({ es: 'Educación', en: 'Education' })}</h4>
								<div class="row">
									<span class="logo" style="--bg:#7a1e2c" aria-hidden="true">EC</span>
									<div>
										<p class="title">Earlham College</p>
										<p>
											{
												t({
													es: 'Licenciatura en Matemáticas · Especialidad secundaria en Filosofía',
													en: 'BA, Mathematics · Minor in Philosophy',
												})
											}
										</p>
										<p class="dim">1958</p>
									</div>
								</div>
							</section>

							<section class="card" data-beat={b(SKILLS)} data-pan="start">
								<h4>{t({ es: 'Aptitudes', en: 'Skills' })}</h4>
								<ul class="list">
									{
										skills.map((skill) => (
											<li class="row skill">
												<div>
													<p class="title">{skill.name}</p>
													<p class="endorse">
														{skill.faces && (
															<span class="faces" aria-hidden="true">
																{skill.faces.map((face) => (
																	<i>{face}</i>
																))}
															</span>
														)}
														{skill.note}
													</p>
												</div>
											</li>
										))
									}
								</ul>
							</section>

							<section class="card" data-beat={b(NASA)} data-pan="start">
								<h4>{t({ es: 'Reconocimientos y premios', en: 'Honors & awards' })}</h4>
								<ul class="list">
									{
										awards.map((award) => (
											<li class="entry" data-beat={b(award.at)}>
												<div class="clip">
													<div class="row">
														<span class="logo blank" aria-hidden="true">
															<svg viewBox="0 0 24 24" set:html={icons.award} />
														</span>
														<div>
															<p class="title">{award.title}</p>
															<p class="dim">{award.issuer}</p>
															<p class="desc">{award.text}</p>
														</div>
													</div>
												</div>
											</li>
										))
									}
								</ul>
							</section>

							<section class="card">
								<h4>{t({ es: 'Idiomas', en: 'Languages' })}</h4>
								<ul class="list">
									{
										languages.map((language) => (
											<li class="row">
												<div>
													<p class="title">{language.name}</p>
													<p class="dim">{language.level}</p>
												</div>
											</li>
										))
									}
								</ul>
							</section>
						</article>
					</div>

					<div class="toasts" aria-hidden="true">
						{
							toasts.map((toast) => (
								<div class="toast" data-beat={b(toast.from, toast.to)}>
									<span class:list={['toast-icon', toast.icon === 'in' && 'brand']}>
										{toast.icon === 'in' ? 'in' : <svg viewBox="0 0 24 24" set:html={icons[toast.icon]} />}
									</span>
									<p>
										<strong>{toast.title}</strong>
										{toast.text}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>

		<!-- The medal photo darkens the page -->
		<div class="layer shade" style={`--a: ${PHOTO}`} data-beat={b(PHOTO)} data-theme="space">
			<Image
				src={medal}
				alt={t({
					es: 'Barack Obama coloca la Medalla Presidencial de la Libertad a Margaret Hamilton, entre aplausos',
					en: 'Barack Obama places the Presidential Medal of Freedom on Margaret Hamilton, to applause',
				})}
				widths={[720, 1280]}
				sizes="100vw"
			/>
		</div>

		<div class="text stack">
			<p class="beat" data-beat={b(0, HOS)}>
				{
					t({
						es: 'Si LinkedIn hubiera existido en 1976, su perfil no habría parado de cambiar.',
						en: 'Had LinkedIn existed in 1976, her profile would never have stopped changing.',
					})
				}
			</p>
			<p class="beat" data-beat={b(HOS, HTI)} data-year="1976">
				{
					t({
						es: 'Deja el MIT y funda, con Saydean Zeldin, su propia empresa: Higher Order Software.',
						en: 'She leaves MIT and co-founds her own company with Saydean Zeldin: Higher Order Software.',
					})
				}
			</p>
			<p class="beat" data-beat={b(HTI, SKILLS)} data-year="1986">
				{
					t({
						es: 'Después funda Hamilton Technologies y crea el Universal Systems Language.',
						en: 'Later she founds Hamilton Technologies and creates the Universal Systems Language.',
					})
				}
			</p>
			<p class="beat" data-beat={b(SKILLS, NASA)}>
				{
					t({
						es: 'Sus aptitudes, validadas por quienes mejor las conocían.',
						en: 'Her skills, endorsed by the people who knew them best.',
					})
				}
			</p>
			<p class="beat" data-beat={b(NASA, MEDAL)} data-year="2003">
				{
					t({
						es: 'La NASA le concede el Exceptional Space Act Award.',
						en: 'NASA gives her the Exceptional Space Act Award.',
					})
				}
			</p>
			<p class="beat" data-beat={b(MEDAL, QUOTE)} data-year="2016">
				{
					t({
						es: 'Barack Obama le entrega la Medalla Presidencial de la Libertad.',
						en: 'Barack Obama awards her the Presidential Medal of Freedom.',
					})
				}
			</p>
			<blockquote class="beat quote" data-beat={b(QUOTE)}>
				<p>
					{
						t({
							es: '«Definió nuevas formas de ingeniería de software y ayudó a lanzar una industria que cambiaría para siempre la historia de la humanidad».',
							en: '“Hamilton defined new forms of software engineering and helped launch an industry that would forever change human history.”',
						})
					}
				</p>
				<footer>
					{t({ es: 'Mención de la Medalla Presidencial de la Libertad', en: 'Presidential Medal of Freedom citation' })}
				</footer>
			</blockquote>
		</div>
	</div>
</section>

<script>
	import { $, $$ } from '../../scripts/dom';
	import { onProgress } from '../../scripts/scroll';

	// The profile scrolls by itself to the latest change
	const scene = $('[data-scene="legado"]')!;
	const viewport = $('[data-viewport]', scene)!;
	const page = $('[data-page]', scene)!;
	const toasts = $('.toasts', scene)!;
	const from = (el: HTMLElement) => Number(el.dataset.beat!.split(' ')[0]);
	const stops = $$('[data-pan]', page).sort((a, z) => from(a) - from(z));
	const GAP = 12;
	let target: HTMLElement | undefined;

	function pan() {
		if (!target) return;
		let y = target.offsetTop - GAP;
		if (target.dataset.pan === 'end') {
			// A new entry may still be expanding: count the height it will have, not the one it has.
			// And keep it above the notification that comes with it.
			y += $('.row', target)!.offsetHeight + toasts.offsetHeight + GAP * 3 - viewport.clientHeight;
		}
		const max = page.offsetHeight - viewport.clientHeight;
		page.style.setProperty('--pan', `${-Math.round(Math.max(0, Math.min(max, y)))}px`);
	}

	onProgress(scene, () => {
		const next = stops.filter((el) => el.classList.contains('is-on')).at(-1);
		if (next === target) return;
		target = next;
		pan();
	});

	// Once an entry finishes expanding, everything below it has moved
	page.addEventListener('transitionend', (event) => {
		if (event.propertyName === 'grid-template-rows') pan();
	});
	window.addEventListener('resize', pan);
</script>

