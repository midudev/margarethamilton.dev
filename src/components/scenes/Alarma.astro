---
import { Image } from 'astro:assets';
import Dsky from '../Dsky.astro';
import launch from '../../assets/photos/apollo11-launch.jpg';
import eagle from '../../assets/photos/eagle-lunar-orbit.jpg';
import missionControl from '../../assets/photos/mission-control.jpg';
import { getLang, translator } from '../../i18n';

const t = translator(getLang(Astro));
---

<section class="scene alarma" data-scene="alarma" data-theme="space" data-year="1969" style="--len: 1300">
	<div class="stage">
		<div class="layer shade" style="--b: 0.06">
			<Image src={launch} alt={t({ es: 'El cohete Saturn V del Apollo 11 despegando entre llamas', en: 'The Apollo 11 Saturn V rocket lifting off in flames' })} widths={[720, 1280, 1920]} sizes="100vw" />
		</div>
		<div class="layer shade" style="--a: 0.06; --b: 0.13">
			<Image
				src={eagle}
				alt={t({
					es: 'El módulo lunar Eagle, dorado y con las patas desplegadas, en órbita sobre el negro del espacio',
					en: 'The lunar module Eagle, gold with its legs deployed, in orbit against the black of space',
				})}
				widths={[720, 1280, 1920]}
				sizes="100vw"
			/>
		</div>

		<div class="layer dsky-layer" style="--a: 0.13; --b: 0.4" aria-hidden="true">
			<div class="dsky-wrap">
				<Dsky id="dsky-1202" prog="63" verb="16" noun="68" r1="+33500" r2="-00610" r3="+05740" />
			</div>
		</div>

		<div class="layer shade" style="--a: 0.4; --b: 0.46">
			<Image
				src={missionControl}
				alt={t({
					es: 'La sala de control de misión en Houston, con consolas y pantallas, durante el Apollo 11',
					en: 'Mission Control in Houston, with consoles and screens, during Apollo 11',
				})}
				widths={[720, 1280, 1920]}
				sizes="100vw"
			/>
		</div>
		<!-- 16 mm film from Aldrin's window: scrolling advances it frame by frame -->
		<div class="layer film shade" style="--a: 0.46">
			<video
				data-film
				data-src="/video/eagle-landing-16mm.mp4"
				poster="/video/eagle-landing-16mm.jpg"
				width="720"
				height="720"
				muted
				playsinline
				disablepictureinpicture
				preload="auto"
				role="img"
				aria-label={t({
					es: 'Película original de 16 mm del descenso, filmada desde la ventana de Buzz Aldrin: el suelo lunar se acerca, el motor levanta polvo y la sombra del Eagle cubre el cuadro al tocar la superficie',
					en: 'Original 16 mm film of the descent, shot from Buzz Aldrin’s window: the lunar surface rushes closer, the engine kicks up dust and Eagle’s shadow fills the frame at touchdown',
				})}
			></video>
		</div>

		<div class="text stack">
			<p class="beat" data-beat="0 0.06">{t({ es: '16 de julio de 1969. Despega el Apollo 11.', en: 'July 16, 1969. Apollo 11 lifts off.' })}</p>
			<p class="beat" data-beat="0.06 0.13">
				{t({ es: 'Cuatro días después, el Eagle desciende hacia la Luna.', en: 'Four days later, Eagle descends toward the Moon.' })}
			</p>

			<div class="beat radio" data-beat="0.14 0.2" data-theme="alarm">
				<span class="mono">102:38:26</span>
				<q>Program alarm.</q>
				<span class="who">Neil Armstrong</span>
			</div>
			<div class="beat radio" data-beat="0.2 0.26" data-theme="alarm">
				<span class="mono">102:38:30</span>
				<q>It’s a 1202.</q>
				<span class="who">Neil Armstrong</span>
			</div>
			<p class="beat" data-beat="0.26 0.32" data-theme="space">
				{
					t({
						es: 'El ordenador estaba recibiendo más trabajo del que podía hacer.',
						en: 'The computer was being given more work than it could handle.',
					})
				}
			</p>
			<p class="beat" data-beat="0.32 0.4">
				{
					t({
						es: 'No se colgó. El software de Margaret sabía qué era importante: soltó lo secundario y siguió guiando el descenso.',
						en: 'It didn’t crash. Margaret’s software knew what mattered: it dropped the less important work and kept guiding the descent.',
					})
				}
			</p>
			<div class="beat radio" data-beat="0.4 0.46">
				<span class="mono">102:38:53</span>
				<q>We’re Go on that alarm.</q>
				<span class="who">
					{t({ es: 'Charlie Duke, desde Houston. Confiaron en el software.', en: 'Charlie Duke, from Houston. They trusted the software.' })}
				</span>
			</div>
			<p class="beat" data-beat="0.48 0.64">
				{
					t({
						es: 'Una cámara de 16 mm lo filmaba todo desde la ventana de Buzz Aldrin.',
						en: 'A 16 mm camera filmed it all from Buzz Aldrin’s window.',
					})
				}
			</p>
			<div class="beat radio" data-beat="0.8 0.88">
				<span class="mono">102:45:40</span>
				<q>Contact light.</q>
				<span class="who">Buzz Aldrin</span>
			</div>
			<div class="beat radio landed" data-beat="0.89">
				<span class="mono">102:45:58</span>
				<q>The Eagle has landed.</q>
				<span class="who">Neil Armstrong</span>
			</div>
		</div>
	</div>
</section>

<script>
	import { $ } from '../../scripts/dom';
	import { onProgress, segment } from '../../scripts/scroll';
	import { createDsky } from '../../scripts/dsky';

	const scene = $('[data-scene="alarma"]')!;
	const dsky = createDsky($('#dsky-1202', scene)!);

	const pad = (n: number, sign = '+') => sign + String(Math.max(0, Math.round(n))).padStart(5, '0');
	const steps = [0.13, 0.14, 0.2, 0.32, 0.4, Infinity];
	let current = -1;

	onProgress(scene, (p) => {
		const step = steps.findIndex((limit) => p < limit);

		// While descending, the registers count down with the scroll
		if (step <= 1 || step === 4) {
			const t = segment(p, 0.09, 0.4);
			dsky.show({ r1: pad(33500 - t * 26000), r2: pad(610 - t * 420, '-'), r3: pad(5740 - t * 4100) });
		}

		if (step === current) return;
		const previous = current;
		current = step;

		if (step <= 1) {
			dsky.show({ prog: '63', verb: '16', noun: '68', lamps: [] });
			dsky.computing(true);
		} else if (step === 2) {
			dsky.show({ lamps: ['PROG'] });
			dsky.computing(true);
		} else if (step === 3) {
			const alarm = () => dsky.show({ verb: '05', noun: '09', r1: '01202', r2: '', r3: '', lamps: ['PROG'] });
			dsky.computing(false);
			if (step > previous) dsky.press(['VERB', '0', '5', 'NOUN', '0', '9', 'ENTR']).then(() => current === step && alarm());
			else alarm();
		} else {
			dsky.show({ prog: '63', verb: '16', noun: '68', lamps: [] });
			dsky.computing(true);
		}
	});

	// The descent film (6 frames per second, like the original) advances with the scroll.
	// The trip toward the surface goes by quickly and the last seconds, until contact, play in slow motion.
	const film = $<HTMLVideoElement>('[data-film]', scene)!;
	const FPS = 6;
	const reel: [progress: number, seconds: number][] = [
		[0.46, 0],
		[0.68, 270],
		[0.78, 290],
		[0.87, 298],
	];
	let frame = 0;
	let seeking = false;
	let loading = false;

	const frameAt = (p: number) => {
		const next = reel.findIndex(([at]) => p < at);
		if (next === 0) return 0;
		if (next === -1) return Math.floor(reel[reel.length - 1][1] * FPS);
		const [p0, t0] = reel[next - 1];
		const [p1, t1] = reel[next];
		return Math.floor((t0 + segment(p, p0, p1) * (t1 - t0)) * FPS);
	};

	// One seek at a time: if scrolling outpaces the decoder, it jumps straight to the last requested frame
	const seek = () => {
		if (seeking || film.readyState < 2) return;
		const target = Math.min(frame, Math.floor(film.duration * FPS) - 1);
		if (Math.floor(film.currentTime * FPS) === target) return;
		seeking = true;
		film.currentTime = (target + 0.5) / FPS;
	};

	// Download it whole so any seek is instant
	async function load() {
		const src = film.dataset.src!;
		try {
			const res = await fetch(src);
			if (!res.ok) throw new Error(res.statusText);
			film.src = URL.createObjectURL(await res.blob());
		} catch {
			film.src = src;
		}
		prime();
	}

	// iOS ignores preload="auto": it only loads the metadata, never fires loadeddata and doesn't
	// paint seeks until the video has played. A muted play() makes it load the frames.
	// Low Power Mode rejects it, so it tries again on the next tap
	function prime() {
		film.play().then(
			() => {
				film.pause();
				seek();
			},
			() => addEventListener('touchend', prime, { once: true, passive: true }),
		);
	}

	film.addEventListener('seeked', () => {
		seeking = false;
		seek();
	});

	onProgress(scene, (p) => {
		if (!loading) {
			loading = true;
			load();
		}
		frame = frameAt(p);
		seek();
	});
</script>

<style>
	.shade::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0) 55%);
	}

	/* The frame arrives rotated 45° so the horizon is level; it slowly zooms in while descending */
	.film video {
		position: absolute;
		left: 50%;
		top: 50%;
		width: max(118vh, 92vw);
		height: max(118vh, 92vw);
		translate: -50% -50%;
		scale: calc(1 + 0.1 * clamp(0, (var(--p, 0) - 0.46) / 0.41, 1));
		background: var(--vacio);
	}

	.dsky-wrap {
		position: absolute;
		right: clamp(1rem, 8vw, 9rem);
		top: 50%;
		width: min(36vw, 54vh, 460px);
		translate: 0 -50%;
	}

	.text {
		position: absolute;
		left: var(--gutter);
		right: var(--gutter);
		bottom: clamp(3.5rem, 12vh, 8rem);
		align-items: end;
		pointer-events: none;
	}

	.text > p {
		max-width: 24ch;
		font-size: var(--t-lead);
		line-height: 1.12;
		letter-spacing: -0.015em;
		text-wrap: pretty;
	}

	.radio {
		display: grid;
		gap: 0.5rem;
		justify-items: start;
	}

	.radio .mono {
		color: var(--fg-dim);
		font-variant-numeric: tabular-nums;
	}

	.radio q {
		font-size: var(--t-display);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.025em;
		quotes: '«' '»';
	}

	.radio q:lang(en) {
		quotes: '“' '”';
	}

	.radio .who {
		font-size: var(--t-body);
	}

	.landed q {
		font-size: var(--t-giant);
		font-weight: 300;
		line-height: 0.9;
		max-width: 10ch;
	}

	@media (min-width: 761px) {
		.text {
			right: auto;
			width: min(52vw, 44rem);
		}

		.landed {
			width: 90vw;
		}
	}

	@media (max-width: 760px) {
		.dsky-wrap {
			top: 7vh;
			right: 50%;
			width: min(74vw, 44vh);
			translate: 50% 0;
		}

		.text > p {
			font-size: 1.35rem;
		}

		.radio q {
			font-size: 2.6rem;
		}

		.landed q {
			font-size: 3.6rem;
		}
	}

	html:not(.js) .layer,
	html:not(.js) .text,
	html:not(.js) .dsky-wrap,
	html:not(.js) .film video {
		position: relative;
		inset: auto;
		translate: none;
	}

	html:not(.js) .film video {
		display: block;
		width: min(100%, 720px);
		height: auto;
		margin-inline: auto;
	}
</style>
