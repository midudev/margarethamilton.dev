---
/**
 * DSKY: the display and keyboard of the Apollo Guidance Computer.
 * Digits are electroluminescent segments; they are driven from
 * src/scripts/dsky.ts by changing data-d (digit) and data-s (sign).
 */
interface Props {
	id: string;
	prog?: string;
	verb?: string;
	noun?: string;
	r1?: string;
	r2?: string;
	r3?: string;
	class?: string;
}

const { id, prog = '', verb = '', noun = '', r1 = '', r2 = '', r3 = '', class: className } = Astro.props;

const t = 1.1;
const h = (x1: number, x2: number, y: number) =>
	`${x1},${y} ${x1 + t},${y - t} ${x2 - t},${y - t} ${x2},${y} ${x2 - t},${y + t} ${x1 + t},${y + t}`;
const v = (x: number, y1: number, y2: number) =>
	`${x},${y1} ${x + t},${y1 + t} ${x + t},${y2 - t} ${x},${y2} ${x - t},${y2 - t} ${x - t},${y1 + t}`;

const segments = {
	a: h(2.6, 11.4, 2),
	b: v(12, 2.6, 11.4),
	c: v(12, 12.6, 21.4),
	d: h(2.6, 11.4, 22),
	e: v(2, 12.6, 21.4),
	f: v(2, 2.6, 11.4),
	g: h(2.6, 11.4, 12),
};

const digitSvg = `<svg viewBox="0 0 14 24">${Object.entries(segments)
	.map(([k, points]) => `<polygon class="s-${k}" points="${points}"/>`)
	.join('')}</svg>`;
const signSvg = `<svg viewBox="0 0 14 24"><polygon class="s-h" points="${h(1, 13, 12)}"/><polygon class="s-v" points="${v(7, 6, 18)}"/></svg>`;

/** Left-pads with spaces: a space is an unlit digit */
const digits = (value: string, n: number) => value.padStart(n, ' ').slice(-n).split('');

const register = (value: string) => {
	const sign = /^[+-]/.test(value) ? value[0] : '';
	return { sign, digits: digits(value.replace(/^[+-]/, ''), 5) };
};

const registers = { r1: register(r1), r2: register(r2), r3: register(r3) };

const lamps = [
	['UPLINK ACTY', 'TEMP'],
	['NO ATT', 'GIMBAL LOCK'],
	['STBY', 'PROG'],
	['KEY REL', 'RESTART'],
	['OPR ERR', 'TRACKER'],
	['', 'ALT'],
	['', 'VEL'],
].flat();

// Faceplate screws, each one tightened to a different angle
const screws = [
	{ x: '2.3cqw', y: '2.3cqw', r: 18 },
	{ x: 'calc(100% - 2.3cqw)', y: '2.3cqw', r: 61 },
	{ x: '2.3cqw', y: 'calc(100% - 2.3cqw)', r: 77 },
	{ x: 'calc(100% - 2.3cqw)', y: 'calc(100% - 2.3cqw)', r: 34 },
];

const keys = [
	{ k: 'VERB', area: '2 / 1 / 4 / 2' },
	{ k: 'NOUN', area: '4 / 1 / 6 / 2' },
	{ k: '+', area: '1 / 2 / 3 / 3' },
	{ k: '−', area: '3 / 2 / 5 / 3' },
	{ k: '0', area: '5 / 2 / 7 / 3' },
	{ k: '7', area: '1 / 3 / 3 / 4' },
	{ k: '4', area: '3 / 3 / 5 / 4' },
	{ k: '1', area: '5 / 3 / 7 / 4' },
	{ k: '8', area: '1 / 4 / 3 / 5' },
	{ k: '5', area: '3 / 4 / 5 / 5' },
	{ k: '2', area: '5 / 4 / 7 / 5' },
	{ k: '9', area: '1 / 5 / 3 / 6' },
	{ k: '6', area: '3 / 5 / 5 / 6' },
	{ k: '3', area: '5 / 5 / 7 / 6' },
	{ k: 'CLR', area: '1 / 6 / 3 / 7' },
	{ k: 'PRO', area: '3 / 6 / 5 / 7' },
	{ k: 'KEY REL', area: '5 / 6 / 7 / 7' },
	{ k: 'ENTR', area: '2 / 7 / 4 / 8' },
	{ k: 'RSET', area: '4 / 7 / 6 / 8' },
];
---

<div class:list={['dsky', 'still', className]} id={id} aria-hidden="true">
	<div class="case">
		<div class="face">
			{screws.map(({ x, y, r }) => <i class="screw" style={`left:${x};top:${y};--r:${r}deg`} />)}

			<div class="dsky-top">
				<div class="window">
					<div class="lamps">
						{lamps.map((lamp) => <span class="lamp" data-lamp={lamp || undefined}>{lamp}</span>)}
					</div>
				</div>

				<div class="window">
					<div class="el">
						<div class="el-row">
							<span class="el-label acty" data-acty>COMP<br />ACTY</span>
							<div class="el-field">
								<span class="el-label">PROG</span>
								<span class="digits" data-field="prog">
									{digits(prog, 2).map((d) => <span class="d" data-d={d} set:html={digitSvg} />)}
								</span>
							</div>
						</div>
						<div class="el-row">
							<div class="el-field">
								<span class="el-label">VERB</span>
								<span class="digits" data-field="verb">
									{digits(verb, 2).map((d) => <span class="d" data-d={d} set:html={digitSvg} />)}
								</span>
							</div>
							<div class="el-field">
								<span class="el-label">NOUN</span>
								<span class="digits" data-field="noun">
									{digits(noun, 2).map((d) => <span class="d" data-d={d} set:html={digitSvg} />)}
								</span>
							</div>
						</div>
						{
							Object.entries(registers).map(([name, reg]) => (
								<div class="el-register">
									<span class="digits" data-field={name}>
										<span class="d sign" data-s={reg.sign} set:html={signSvg} />
										{reg.digits.map((d) => (
											<span class="d" data-d={d} set:html={digitSvg} />
										))}
									</span>
								</div>
							))
						}
					</div>
				</div>
			</div>

			<div class="keys">
				{
					keys.map(({ k, area }) => (
						<span class="key" data-key={k} style={`grid-area: ${area}`}>
							{k}
						</span>
					))
				}
			</div>
		</div>
	</div>
</div>

<style>
	/* Everything is drawn with CSS: light comes from above and slightly to the left */
	.dsky {
		--metal: #aeb2af;
		--glass: #080c0a;
		--el-on: #a3ffc4;
		container-type: inline-size;
		width: 100%;
	}

	/* Aluminium housing: only its rounded rim shows around the faceplate */
	.case {
		padding: 1cqw;
		border-radius: 2.6cqw;
		background: linear-gradient(150deg, #e0e3e0 0%, #a6aaa7 38%, #7d817e 70%, #5d615e 100%);
		box-shadow:
			0 0.25cqw 0.3cqw rgb(0 0 0 / 0.4),
			0 2cqw 3cqw -0.5cqw rgb(0 0 0 / 0.45),
			0 7cqw 12cqw -2cqw rgb(0 0 0 / 0.5);
	}

	/* Painted faceplate, with a fine grain and the light falling off towards the bottom */
	.face {
		position: relative;
		padding: 4.4cqw 4.2cqw 4.6cqw;
		border-radius: 1.8cqw;
		background:
			radial-gradient(130% 90% at 22% -10%, rgb(255 255 255 / 0.26), transparent 62%),
			radial-gradient(rgb(0 0 0 / 0.07) 0.5px, transparent 0.7px) 0 0 / 3px 3px,
			radial-gradient(rgb(255 255 255 / 0.08) 0.5px, transparent 0.7px) 1px 2px / 5px 4px,
			linear-gradient(180deg, #bcc0bd, #a4a8a5 55%, #979b98);
		box-shadow:
			inset 0 0.22cqw 0 rgb(255 255 255 / 0.55),
			inset 0.18cqw 0 0 rgb(255 255 255 / 0.18),
			inset -0.18cqw 0 0 rgb(0 0 0 / 0.1),
			inset 0 -0.25cqw 0 rgb(0 0 0 / 0.22),
			inset 0 0 3cqw rgb(0 0 0 / 0.08);
		font-family: var(--font-sans);
		font-weight: 500;
		user-select: none;
	}

	/* Phillips screws, slightly sunk into the paint */
	.screw {
		position: absolute;
		width: 2.3cqw;
		aspect-ratio: 1;
		translate: -50% -50%;
		rotate: var(--r);
		border-radius: 50%;
		background:
			radial-gradient(circle at 36% 30%, rgb(255 255 255 / 0.85), transparent 38%),
			radial-gradient(circle, #cfd2cf 0 35%, #959996 68%, #626563);
		box-shadow:
			0 0 0 0.18cqw rgb(0 0 0 / 0.12),
			0 0.12cqw 0.18cqw rgb(0 0 0 / 0.55),
			inset 0 -0.12cqw 0.2cqw rgb(0 0 0 / 0.35);
	}

	.screw::before,
	.screw::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 64%;
		height: 15%;
		translate: -50% -50%;
		border-radius: 0.1cqw;
		background: linear-gradient(180deg, #2f3231, #5d605e);
		box-shadow: 0 0.06cqw 0 rgb(255 255 255 / 0.55);
	}

	.screw::after {
		rotate: 90deg;
	}

	.dsky-top {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 3cqw;
	}

	/* Windows cut into the faceplate: shadow under the top lip, light on the bottom one */
	.window {
		position: relative;
		display: grid;
		padding: 0.8cqw;
		border-radius: 1.1cqw;
		background: linear-gradient(180deg, #171a19, #262a28);
		box-shadow:
			0 -0.15cqw 0 rgb(0 0 0 / 0.22),
			0 0.18cqw 0 rgb(255 255 255 / 0.6),
			inset 0 0.5cqw 0.7cqw rgb(0 0 0 / 0.75),
			inset 0 -0.12cqw 0 rgb(255 255 255 / 0.1);
	}

	/* The glass in front: a diagonal reflection and a brighter top edge */
	.window::after {
		content: '';
		position: absolute;
		inset: 0.8cqw;
		border-radius: 0.5cqw;
		background:
			linear-gradient(115deg, rgb(255 255 255 / 0.09) 0 24%, rgb(255 255 255 / 0.025) 24.3% 41%, transparent 41.3%),
			linear-gradient(180deg, rgb(255 255 255 / 0.07), transparent 22%);
		box-shadow: inset 0 0.08cqw 0 rgb(255 255 255 / 0.12);
		pointer-events: none;
	}

	/* Annunciator lamps: frosted lenses in a black frame */
	.lamps {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-auto-rows: 1fr;
		gap: 0.55cqw;
		padding: 0.55cqw;
		border-radius: 0.5cqw;
		background: #0e100f;
		isolation: isolate;
	}

	.lamp {
		position: relative;
		z-index: 0;
		display: grid;
		place-items: center;
		min-height: 7cqw;
		padding: 0.6cqw;
		border-radius: 0.25cqw;
		background: radial-gradient(130% 110% at 50% 35%, #c5c7c1, #a3a59f 70%, #8d8f8a);
		color: rgb(38 40 38 / 0.62);
		font-size: 2.05cqw;
		line-height: 1.05;
		letter-spacing: 0.04em;
		text-align: center;
		text-shadow: 0 0.08cqw 0 rgb(255 255 255 / 0.3);
		box-shadow:
			inset 0 0.35cqw 0.45cqw rgb(0 0 0 / 0.45),
			inset 0 -0.08cqw 0 rgb(255 255 255 / 0.3);
		transition:
			color 0.15s,
			box-shadow 0.15s;
	}

	/* The bulb behind the lens: a hot centre fading to the edges */
	.lamp::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background: radial-gradient(85% 75% at 50% 50%, #fff7d6 0%, #ffd866 42%, #f0a523 100%);
		opacity: 0;
		transition: opacity 0.15s;
	}

	.lamp.is-lit {
		z-index: 1;
		color: #3b2600;
		text-shadow: 0 0 0.3cqw rgb(255 240 200 / 0.8);
		box-shadow:
			inset 0 0.3cqw 0.45cqw rgb(110 55 0 / 0.35),
			0 0 0.5cqw rgb(255 214 120 / 0.9),
			0 0 2.6cqw rgb(255 176 40 / 0.6);
	}

	.lamp.is-lit::before {
		opacity: 1;
	}

	/* Status lamps light up white, caution lamps amber */
	.lamp:is([data-lamp='UPLINK ACTY'], [data-lamp='KEY REL'], [data-lamp='OPR ERR'], [data-lamp='STBY'], [data-lamp='NO ATT'])::before {
		background: radial-gradient(85% 75% at 50% 50%, #ffffff 0%, #f6f5ea 50%, #d9d8c9 100%);
	}

	.lamp.is-lit:is([data-lamp='UPLINK ACTY'], [data-lamp='KEY REL'], [data-lamp='OPR ERR'], [data-lamp='STBY'], [data-lamp='NO ATT']) {
		color: #262622;
		box-shadow:
			inset 0 0.3cqw 0.45cqw rgb(0 0 0 / 0.2),
			0 0 0.5cqw rgb(255 255 240 / 0.9),
			0 0 2.6cqw rgb(255 255 235 / 0.5);
	}

	/* Electroluminescent display: deep green-black glass, unlit segments barely visible */
	.el {
		display: grid;
		gap: 1.6cqw;
		align-content: start;
		padding: 2.4cqw;
		border-radius: 0.5cqw;
		background: radial-gradient(120% 100% at 50% 30%, #101a14, var(--glass) 75%);
		box-shadow: inset 0 0 2.4cqw rgb(0 0 0 / 0.9);
	}

	.el-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
	}

	.el-field {
		display: grid;
		justify-items: end;
		gap: 0.8cqw;
	}

	.el-label {
		padding: 0.5cqw 1cqw;
		border-radius: 0.3cqw;
		background: linear-gradient(180deg, #a6ffc6, #6cf59a);
		color: #06130b;
		font-size: 2.2cqw;
		line-height: 1.1;
		letter-spacing: 0.05em;
		box-shadow:
			0 0 0.35cqw rgb(150 255 190 / 0.8),
			0 0 1.6cqw rgb(108 245 154 / 0.45);
	}

	.acty {
		align-self: start;
		background: rgb(108 245 154 / 0.07);
		color: transparent;
		box-shadow: none;
		transition:
			background-color 0.08s,
			box-shadow 0.08s;
	}

	.acty.is-lit {
		background: linear-gradient(180deg, #a6ffc6, #6cf59a);
		color: #06130b;
		box-shadow:
			0 0 0.35cqw rgb(150 255 190 / 0.8),
			0 0 1.6cqw rgb(108 245 154 / 0.45);
	}

	/* Each register sits under a glowing EL bar */
	.el-register {
		position: relative;
		display: flex;
		justify-content: flex-end;
		padding-top: 1.4cqw;
	}

	.el-register::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 0.35cqw;
		border-radius: 0.2cqw;
		background: #8dffb5;
		box-shadow:
			0 0 0.3cqw rgb(150 255 190 / 0.8),
			0 0 1.2cqw rgb(108 245 154 / 0.4);
	}

	/* Phosphor bloom: a tight halo and a wide one */
	.digits {
		display: flex;
		gap: 0.7cqw;
		filter: drop-shadow(0 0 0.3cqw rgb(120 255 170 / 0.75)) drop-shadow(0 0 1.2cqw rgb(108 245 154 / 0.35));
	}

	.d {
		width: 4.1cqw;
	}

	.d :global(polygon) {
		fill: var(--el);
		opacity: 0.045;
		transition: opacity 0.06s;
	}

	.d[data-d='0'] :global(:is(.s-a, .s-b, .s-c, .s-d, .s-e, .s-f)),
	.d[data-d='1'] :global(:is(.s-b, .s-c)),
	.d[data-d='2'] :global(:is(.s-a, .s-b, .s-g, .s-e, .s-d)),
	.d[data-d='3'] :global(:is(.s-a, .s-b, .s-g, .s-c, .s-d)),
	.d[data-d='4'] :global(:is(.s-f, .s-g, .s-b, .s-c)),
	.d[data-d='5'] :global(:is(.s-a, .s-f, .s-g, .s-c, .s-d)),
	.d[data-d='6'] :global(:is(.s-a, .s-f, .s-g, .s-e, .s-c, .s-d)),
	.d[data-d='7'] :global(:is(.s-a, .s-b, .s-c)),
	.d[data-d='8'] :global(polygon),
	.d[data-d='9'] :global(:is(.s-a, .s-b, .s-c, .s-d, .s-f, .s-g)),
	.sign[data-s='+'] :global(polygon),
	.sign[data-s='-'] :global(.s-h) {
		fill: var(--el-on);
		opacity: 1;
	}

	/* Keyboard: a recessed plate, each key in its own well */
	.keys {
		position: relative;
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		grid-template-rows: repeat(6, 5.6cqw);
		gap: 1.4cqw;
		margin-top: 3.6cqw;
		padding: 2.2cqw 2cqw 2.6cqw;
		border-radius: 1.1cqw;
		background: linear-gradient(180deg, #969a97, #a7aba8);
		box-shadow:
			0 -0.15cqw 0 rgb(0 0 0 / 0.18),
			0 0.18cqw 0 rgb(255 255 255 / 0.55),
			inset 0 0.5cqw 0.8cqw rgb(0 0 0 / 0.32);
		isolation: isolate;
	}

	/* Black plastic keys with white legends, slightly dished on top */
	.key {
		position: relative;
		display: grid;
		place-items: center;
		border-radius: 0.75cqw;
		background:
			linear-gradient(180deg, rgb(255 255 255 / 0.11), transparent 16%),
			radial-gradient(150% 120% at 50% 115%, #303436, #141617 58%, #0a0b0c);
		color: #ecebe3;
		font-size: 2.6cqw;
		line-height: 1;
		text-align: center;
		text-shadow: 0 0 0.12cqw rgb(255 255 255 / 0.3);
		box-shadow:
			inset 0 0.14cqw 0 rgb(255 255 255 / 0.2),
			inset 0 -0.18cqw 0.12cqw rgb(0 0 0 / 0.65),
			0 0.55cqw 0 #050606,
			0 0.75cqw 0.8cqw rgb(0 0 0 / 0.5);
		transition:
			transform 0.08s,
			box-shadow 0.08s;
	}

	.key::before {
		content: '';
		position: absolute;
		inset: -0.45cqw -0.45cqw -0.95cqw;
		z-index: -1;
		border-radius: 1cqw;
		background: linear-gradient(180deg, #353937, #5b5f5c);
		box-shadow:
			inset 0 0.4cqw 0.6cqw rgb(0 0 0 / 0.75),
			0 0.12cqw 0 rgb(255 255 255 / 0.4);
	}

	.key:is([data-key='+'], [data-key='−'], [data-key='0'], [data-key='1'], [data-key='2'], [data-key='3'], [data-key='4'], [data-key='5'], [data-key='6'], [data-key='7'], [data-key='8'], [data-key='9']) {
		font-size: 4.2cqw;
	}

	.key.is-pressed {
		transform: translateY(0.45cqw);
		box-shadow:
			inset 0 0.14cqw 0 rgb(255 255 255 / 0.14),
			inset 0 -0.18cqw 0.12cqw rgb(0 0 0 / 0.65),
			0 0.1cqw 0 #050606,
			0 0.2cqw 0.3cqw rgb(0 0 0 / 0.5);
	}
</style>
