---
/**
 * Keepsakes from each milestone that drop onto the table like stickers and stay there,
 * building a collage. `at` is the scene progress at which each one drops.
 */
import { Image } from 'astro:assets';
import paoli from '../assets/stickers/paoli-1940.jpg';
import sage from '../assets/stickers/sage-console.jpg';
import apolloProgram from '../assets/stickers/apollo-program.png';
import apollo8 from '../assets/stickers/apollo-8.png';
import { getLang, translator } from '../i18n';

interface Props {
	at: number[];
}

const { at } = Astro.props;
const t = translator(getLang(Astro));

// The Lorenz attractor: the weather-forecasting equations that draw a butterfly
let [x, y, z] = [0.1, 0, 0];
const points: string[] = [];
for (let i = 0; i < 6000; i++) {
	const dt = 0.006;
	const [dx, dy, dz] = [10 * (y - x), x * (28 - z) - y, x * y - (8 / 3) * z];
	x += dx * dt;
	y += dy * dt;
	z += dz * dt;
	if (i > 300 && i % 4 === 0) points.push(`${(100 + x * 4.1).toFixed(1)} ${(186 - z * 3.4).toFixed(1)}`);
}
const lorenz = `M${points.join('L')}`;

const stickers = [
	{ id: 'postcard', r: -7 },
	{ id: 'exam', r: 5 },
	{ id: 'lorenz', r: 4 },
	{ id: 'sage', r: -4 },
	{ id: 'apollo', r: 11 },
	{ id: 'apollo8', r: -9 },
];
const style = (i: number) => `--r:${stickers[i].r}deg`;
---

<div class="stickers" aria-hidden="true">
	<figure class="sticker postcard" data-beat={at[0]} style={style(0)}>
		<div class="paper">
			<Image src={paoli} alt="" widths={[360, 600]} sizes="(max-width: 760px) 40vw, 300px" />
			<figcaption>Paoli, Ind.</figcaption>
			<svg class="postmark" viewBox="0 0 120 120">
				<defs>
					<path id="postmark-ring" d="M60 60m-41 0a41 41 0 1 1 82 0a41 41 0 1 1-82 0" />
				</defs>
				<circle cx="60" cy="60" r="52" />
				<circle cx="60" cy="60" r="33" />
				<text><textPath href="#postmark-ring" startOffset="2%">PAOLI · IND · PAOLI · IND ·</textPath></text>
				<text x="60" y="56" class="date">AUG 17</text>
				<text x="60" y="72" class="date">1936</text>
			</svg>
		</div>
	</figure>

	<figure class="sticker exam" data-beat={at[1]} style={style(1)}>
		<div class="paper">
			<p class="exam-head">EARLHAM COLLEGE<br />MATHEMATICS<br />FINAL EXAMINATION, 1958</p>
			<p class="exam-name">Name: <span class="pencil">Margaret Heafield</span></p>
			<ol>
				<li>
					Find dy/dx if y = x² sin x.
					<span class="pencil">y′ = 2x sin x + x² cos x</span>
				</li>
				<li>Evaluate ∫₀¹ eˣ dx. <span class="pencil">e − 1</span></li>
				<li>Prove that √2 is irrational.</li>
			</ol>
		</div>
	</figure>

	<figure class="sticker lorenz" data-beat={at[2]} style={style(2)}>
		<div class="paper">
			<svg viewBox="0 0 200 200">
				<path d={lorenz} pathLength="1" />
			</svg>
			<figcaption>{t({ es: 'el tiempo, según Lorenz', en: 'weather, according to Lorenz' })}</figcaption>
		</div>
	</figure>

	<figure class="sticker photo sage" data-beat={at[3]} style={style(3)}>
		<div class="paper">
			<Image src={sage} alt="" widths={[360, 600]} sizes="(max-width: 760px) 40vw, 280px" />
			<figcaption>SAGE, AN/FSQ-7</figcaption>
		</div>
	</figure>

	<figure class="sticker patch apollo" data-beat={at[4]} style={style(4)}>
		<Image src={apolloProgram} alt="" widths={[200, 320]} sizes="140px" />
	</figure>

	<figure class="sticker patch apollo8" data-beat={at[5]} style={style(5)}>
		<Image src={apollo8} alt="" widths={[200, 320]} sizes="160px" />
	</figure>
</div>

<style>
	.stickers {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 2;
	}

	/* Each sticker drops from above, spinning, and settles with a small bounce */
	.sticker {
		position: absolute;
		margin: 0;
		left: var(--x);
		right: var(--x2);
		top: var(--y);
		width: var(--w);
		opacity: 0;
		transform: translate(var(--from-x, -8vw), -70vh) rotate(calc(var(--r) - 24deg)) scale(1.5);
		filter: drop-shadow(0 40px 30px rgb(0 0 0 / 0.25));
		transition:
			transform 0.85s cubic-bezier(0.2, 1.3, 0.35, 1),
			opacity 0.2s ease,
			filter 0.85s ease;
		will-change: transform;
	}

	.sticker.is-on {
		opacity: 1;
		transform: rotate(var(--r));
		filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.16)) drop-shadow(0 10px 14px rgb(0 0 0 / 0.1));
	}

	.paper {
		position: relative;
		padding: 0.45rem;
		background: #fff;
		border-radius: 6px;
		overflow: hidden;
	}

	/* Vinyl sheen */
	.paper::after,
	.patch::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(115deg, rgb(255 255 255 / 0) 35%, rgb(255 255 255 / 0.35) 48%, rgb(255 255 255 / 0) 60%);
		pointer-events: none;
	}

	.sticker img {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: 0.4rem;
		color: #3a3d38;
		font-size: clamp(0.6875rem, 0.55rem + 0.35vw, 0.9375rem);
		line-height: 1.1;
	}

	/* Postcard from Paoli with its postmark */
	.postcard {
		--x: 5%;
		--y: 14%;
		--w: clamp(140px, 15vw, 280px);
		--from-x: -20vw;
	}

	.postcard img {
		aspect-ratio: 4 / 3;
		object-fit: cover;
		filter: sepia(0.45) contrast(1.05) brightness(1.04);
	}

	.postcard figcaption {
		font-style: italic;
		font-size: clamp(0.9rem, 0.6rem + 0.9vw, 1.5rem);
		font-weight: 500;
		color: #7a3b2a;
	}

	.postmark {
		position: absolute;
		right: -6%;
		bottom: 2%;
		width: 42%;
		transform: rotate(-14deg);
		fill: none;
		stroke: rgb(31 44 92 / 0.72);
		stroke-width: 2.4;
	}

	.postmark text {
		fill: rgb(31 44 92 / 0.72);
		stroke: none;
		font-family: var(--font-mono);
		font-size: 10.5px;
		font-weight: 500;
		letter-spacing: 0.08em;
	}

	.postmark .date {
		font-size: 13px;
		text-anchor: middle;
	}

	/* Mimeographed exam, in the purple ink of spirit duplicator copies */
	.exam {
		--x2: 5%;
		--y: 8%;
		--w: clamp(130px, 13vw, 230px);
		--from-x: 18vw;
	}

	.exam .paper {
		padding: 0.9rem 0.85rem 1rem;
		background:
			repeating-linear-gradient(180deg, transparent 0 1.35em, rgb(90 140 200 / 0.18) 1.35em calc(1.35em + 1px)),
			#fbfaf4;
		color: #5a4aa6;
		font-family: var(--font-mono);
		font-size: clamp(0.4375rem, 0.25rem + 0.42vw, 0.6875rem);
		line-height: 1.35;
	}

	.exam-head {
		margin-bottom: 0.6em;
		text-align: center;
		font-weight: 500;
		letter-spacing: 0.05em;
	}

	.exam ol {
		margin: 0.6em 0 0;
		padding-left: 1.6em;
	}

	.exam li + li {
		margin-top: 0.5em;
	}

	.pencil {
		display: block;
		color: #4d4f4a;
		font-family: var(--font-sans);
		font-style: italic;
		font-size: 1.25em;
		transform: rotate(-1.5deg);
	}

	.exam-name .pencil {
		display: inline;
	}

	/* The Lorenz butterfly, on graph paper */
	.lorenz {
		--x: 8%;
		--y: 56%;
		--w: clamp(110px, 11vw, 200px);
		--from-x: -12vw;
	}

	.lorenz .paper {
		background:
			linear-gradient(rgb(70 130 190 / 0.16) 1px, transparent 1px) 0 0 / 10px 10px,
			linear-gradient(90deg, rgb(70 130 190 / 0.16) 1px, transparent 1px) 0 0 / 10px 10px,
			#fbfcf8;
	}

	.lorenz svg {
		display: block;
		width: 100%;
	}

	.lorenz path {
		fill: none;
		stroke: #1f3d7a;
		stroke-width: 0.55;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		transition: stroke-dashoffset 2.6s ease-in-out 0.5s;
	}

	.lorenz.is-on path {
		stroke-dashoffset: 0;
	}

	.lorenz figcaption {
		font-style: italic;
		text-align: center;
	}

	.sage {
		--x2: 6%;
		--y: 52%;
		--w: clamp(130px, 15vw, 260px);
		--from-x: 14vw;
	}

	.sage .paper {
		padding-bottom: 0.2rem;
	}

	.sage figcaption {
		font-family: var(--font-mono);
		font-size: clamp(0.5625rem, 0.45rem + 0.3vw, 0.75rem);
		padding: 0.15rem 0.1rem 0.25rem;
	}

	/* Die-cut patches: the white border follows the outline */
	.patch img {
		filter: drop-shadow(3px 0 0 #fff) drop-shadow(-3px 0 0 #fff) drop-shadow(0 3px 0 #fff) drop-shadow(0 -3px 0 #fff);
	}

	.patch::after {
		border-radius: 50%;
	}

	.apollo {
		--x2: 23%;
		--y: 5%;
		--w: clamp(70px, 7vw, 120px);
		--from-x: 6vw;
	}

	.apollo8 {
		--x2: 15%;
		--y: 72%;
		--w: clamp(80px, 8.5vw, 140px);
		--from-x: 10vw;
	}

	.apollo8::after {
		display: none;
	}

	@media (max-width: 760px) {
		.postcard {
			--x: 3%;
			--y: 3%;
			--w: 42vw;
		}

		.exam {
			--x2: 3%;
			--y: 7%;
			--w: 38vw;
		}

		.apollo {
			--x2: 40%;
			--y: 14%;
			--w: 20vw;
		}

		.lorenz {
			--x: 5%;
			--y: 49%;
			--w: 30vw;
		}

		.sage {
			--x2: 4%;
			--y: 48%;
			--w: 40vw;
		}

		.apollo8 {
			--x2: 38%;
			--y: 57%;
			--w: 20vw;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sticker {
			transform: rotate(var(--r));
			transition: opacity 0.4s ease;
		}

		.lorenz path {
			stroke-dashoffset: 0;
			transition: none;
		}
	}

	html:not(.js) .stickers {
		display: none;
	}
</style>
