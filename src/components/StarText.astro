---
/**
 * Text whose letters are born from stars. Each star travels to its letter,
 * flashes on arrival and its light condenses into the glyph. `start`, `spread` and `dur`
 * are ranges of the scene progress (0–1); the starting positions are
 * computed by src/scripts/stars.ts.
 *
 * Each letter's progress is set from JS, and only on the letters that are moving:
 * driving them all from the scene's --p would restyle every letter on every frame.
 */
interface Props {
	text: string;
	start: number;
	spread?: number;
	dur?: number;
	class?: string;
}

const { text, start, spread = 0.2, dur = 0.16, class: className } = Astro.props;

const chars = text.replace(/ /g, '').length;
let index = 0;
const words = text.split(' ').map((word) =>
	word.split('').map((char) => ({ char, d: (index++ / Math.max(1, chars - 1)).toFixed(3) })),
);
---

<span class:list={['star-text', 'still', className]} data-start={start} data-spread={spread} data-dur={dur} aria-hidden="true">
	{
		words.map((word, i) => (
			<>
				<span class="w">
					{word.map(({ char, d }) => (
						<span class="l" data-d={d}>
							<span class="g">{char}</span>
						</span>
					))}
				</span>
				{i < words.length - 1 && ' '}
			</>
		))
	}
</span>

<script>
	import { $$ } from '../scripts/dom';
	import { clamp, onProgress } from '../scripts/scroll';

	for (const text of $$('.star-text')) {
		const scene = text.closest<HTMLElement>('[data-scene]')!;
		const [start, spread, dur] = [text.dataset.start, text.dataset.spread, text.dataset.dur].map(Number);
		const letters = $$('.l', text).map((el) => ({ el, d: Number(el.dataset.d), t: -1 }));

		onProgress(scene, (p) => {
			for (const letter of letters) {
				const t = Math.round(clamp((p - start - letter.d * spread) / dur) * 1000) / 1000;
				if (t === letter.t) continue;
				const moving = t > 0 && t < 1;
				if (moving !== (letter.t > 0 && letter.t < 1)) letter.el.classList.toggle('is-moving', moving);
				letter.t = t;
				letter.el.style.setProperty('--t', String(t));
			}
		});
	}
</script>

<style>
	/* Typed as numbers, the letter's values don't have to be parsed again on every restyle: it costs half */
	@property --t {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --m0 {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --m {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --f {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --out {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --g0 {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	@property --g {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	.w {
		display: inline-block;
		white-space: nowrap;
	}

	.l {
		/* t: this letter's progress. m: the star's journey. f: flash. g: glyph reveal */
		--t: 0;
		--m0: clamp(0, calc(var(--t) / 0.72), 1);
		--m: calc(var(--m0) * var(--m0) * (3 - 2 * var(--m0)));
		--f: clamp(0, calc((var(--t) - 0.6) / 0.2), 1);
		--out: clamp(0, calc((var(--t) - 0.74) / 0.22), 1);
		--g0: clamp(0, calc((var(--t) - 0.66) / 0.34), 1);
		--g: calc(var(--g0) * var(--g0) * (3 - 2 * var(--g0)));
		position: relative;
		display: inline-block;
	}

	/* The light condenses into the letter: it arrives blurred and bright, then settles */
	.g {
		display: inline-block;
		color: rgb(236 236 230 / var(--g));
		text-shadow:
			0 0 calc((1 - var(--g)) * 0.5em) rgb(var(--tint, 255 255 255) / calc((1 - var(--g)) * var(--f))),
			0 0 calc((1 - var(--g)) * 0.12em) rgb(255 255 255 / calc((1 - var(--g)) * var(--f)));
		transform: scale(calc(1.14 - 0.14 * var(--g)));
		transform-origin: 50% 60%;
	}

	/* The star: a sharp point that travels along a gentle curve and flashes on arrival */
	.l::before {
		--size: calc((1.2 + var(--mag, 0.8) * 1.8) * 1px);
		--arc: sin(calc(var(--m) * 180deg));
		content: '';
		position: absolute;
		left: 50%;
		top: 55%;
		width: var(--size);
		height: var(--size);
		margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
		border-radius: 50%;
		background: rgb(var(--tint, 255 255 255));
		box-shadow: 0 0 calc(var(--size) * (0.8 + 5 * var(--f))) calc(var(--size) * 0.6 * var(--f))
			rgb(var(--tint, 255 255 255) / calc(0.35 + 0.45 * var(--f)));
		opacity: calc((var(--mag, 0.8) + (1 - var(--mag, 0.8)) * var(--m)) * (1 - var(--out)));
		transform: translate(
				calc(var(--dx, 0px) * (1 - var(--m)) + var(--ax, 0px) * var(--arc)),
				calc(var(--dy, 0px) * (1 - var(--m)) + var(--ay, 0px) * var(--arc))
			)
			scale(calc(1 + 1.6 * var(--f)));
		pointer-events: none;
	}

	/* A layer of its own only while travelling: resting, a hundred stars would be a hundred layers */
	.l.is-moving::before {
		will-change: transform;
	}

	@media (prefers-reduced-motion: reduce) {
		.g {
			transform: none;
			text-shadow: none;
		}

		.l::before {
			display: none;
		}
	}

	html:not(.js) .g {
		color: inherit;
		transform: none;
		text-shadow: none;
	}

	html:not(.js) .l::before {
		display: none;
	}
</style>
